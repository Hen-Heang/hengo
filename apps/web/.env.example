# Browser-visible Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-only OpenAI configuration. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=your_openai_api_key
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=tts-1

# Explicit local UI mode. Mock output is visibly labeled and does not call OpenAI.
KOREAN_COACH_MOCK_MODE=false


# Hengo MCP connector (docs/chatgpt-mcp-integration.md), serving Claude and,
# where supported, ChatGPT. The first three are required together — the /mcp
# endpoint returns 503 and serves nothing until they are set. There is no
# "disable auth" option by design.
# MCP_RESOURCE_URL must be the endpoint's own public https URL: it is published
# as the RFC 8707 resource identifier and every access token's audience is
# checked against it.
MCP_RESOURCE_URL=https://your-deployment.example.com/mcp
SUPABASE_OAUTH_ISSUER=https://your-project.supabase.co/auth/v1
# Comma-separated allowlist of OAuth client ids permitted to call the
# endpoint (e.g. one per registered connector — Claude, ChatGPT). Tokens
# issued to any other client are rejected. Must contain at least one id: an
# empty list is a configuration error, not "allow everyone".
MCP_ALLOWED_CLIENT_IDS=the_oauth_client_id_registered_for_claude,the_oauth_client_id_registered_for_chatgpt
# Gates the write tools (create/update/complete/capture). Defaults to false
# — the write tools are absent from tools/list entirely until this is set to
# the literal string "true". Verify the read tools end to end first.
MCP_WRITE_ENABLED=false

# Existing optional integrations
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_web_oauth_client_id
NEXT_PUBLIC_VAPID_KEY=your_web_push_vapid_public_key

# Existing global model overrides
AI_MODEL=gpt-5-mini
TTS_MODEL=tts-1
